APP_ENV=production
APP_BASE_PATH=/PragSys
APP_VERSION=4.1.0
APP_HOST=0.0.0.0
APP_PORT=8000
APP_HOST_PORT=8011
SYS_PRAGAS_CONTAINER_NAME=syspragas-prod
APP_RELOAD=false
ALLOW_REMOTE_ACCESS=true
LOG_LEVEL=INFO

DATABASE_URL=sqlite:////data/syspragas.db

# Gere um valor aleatorio forte antes do primeiro deploy.
JWT_SECRET=<CHANGE_ME_STRONG_RANDOM_SECRET>
SETTINGS_ENCRYPTION_KEY=

DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=<CHANGE_ME_STRONG_ADMIN_PASSWORD>
DEFAULT_ADMIN_NAME=Administrador

# Dados basicos da empresa
COMPANY_NAME=SysPragas
COMPANY_LEGAL_NAME=
COMPANY_TRADE_NAME=
COMPANY_CNPJ=
COMPANY_PHONE=
COMPANY_TIMEZONE=America/Sao_Paulo
TECHNICAL_SIGNATURES_DIR=assinaturas_tecnicas
CERTIFICATE_MODELS_DIR=modelos
TECHNICAL_RESPONSIBLE_NAME=
TECHNICAL_RESPONSIBLE_REGISTRY=
SANITARY_LICENSE_NUMBER=
SANITARY_LICENSE_EXPIRY=
ENVIRONMENTAL_LICENSE_NUMBER=
ENVIRONMENTAL_LICENSE_EXPIRY=
TOXICOLOGY_CENTER_PHONE=

# Google Calendar OAuth
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_ACCESS_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://movisystecnologia.com.br/PragSys/api/v1/google-calendar/oauth/callback
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/calendar.events openid email profile

# WhatsApp integration
WHATSAPP_ENABLED=true
WHATSAPP_PROVIDER=evolution
WHATSAPP_API_BASE_URL=http://whatsapp-bridge:3100
WHATSAPP_MESSAGE_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_AUTH_TOKEN=
WHATSAPP_SENDER_ID=
WHATSAPP_INSTANCE_NAME=syspragas
WHATSAPP_STATUS_API_URL=
WHATSAPP_QR_API_URL=
WHATSAPP_CONNECT_API_URL=
WHATSAPP_LOGOUT_API_URL=
WHATSAPP_TIMEOUT_SECONDS=15
WHATSAPP_BRIDGE_API_KEY=
WHATSAPP_BRIDGE_HOST=0.0.0.0
WHATSAPP_BRIDGE_CONTAINER_NAME=syspragas-whatsapp-bridge-prod
WHATSAPP_BRIDGE_HOST_BIND=127.0.0.1
WHATSAPP_BRIDGE_HOST_PORT=3111
WHATSAPP_BRIDGE_PORT=3100

# NF-e provider
NFE_PROVIDER=focus_nfe
NCM_EXTERNAL_SOURCE_URL=
NCM_EXTERNAL_SOURCE_TOKEN=
FOCUS_NFE_API_BASE_URL=
FOCUS_NFE_API_KEY=
FOCUS_NFE_ENVIRONMENT=producao
FOCUS_NFE_TIMEOUT_SECONDS=30
FOCUS_NFE_WEBHOOK_SECRET=
SIMPLES_NACIONAL_DEFAULT_ALIQUOTA=6.0
SIMPLES_NACIONAL_DEFAULT_ANEXO=III

# NF-e direta SEFAZ
SEFAZ_NFE_UF=SP
SEFAZ_NFE_SERIE=1
SEFAZ_NFE_CERTIFICATE_PATH=/run/sefaz/certificado/certificado_a1.pfx
SEFAZ_NFE_CERTIFICATE_PASSWORD=
SEFAZ_NFE_XSD_DIR=/run/sefaz/xsd
SEFAZ_NFE_WS_URLS_JSON=
SEFAZ_NFE_VERIFY_TLS=true
COMPANY_IE=
COMPANY_IM=
COMPANY_CNAE=
COMPANY_CRT=1
COMPANY_STREET=
COMPANY_NUMBER=
COMPANY_DISTRICT=
COMPANY_CITY=
COMPANY_CITY_CODE=
COMPANY_STATE=
COMPANY_STATE_CODE=
COMPANY_ZIP_CODE=
