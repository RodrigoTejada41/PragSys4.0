DATABASE_URL=sqlite:///./syspragas.db
JWT_SECRET=<SECRET>
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=syspragas123

# Google Calendar OAuth
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_ACCESS_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/google-calendar/oauth/callback
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/calendar.events openid email profile

# NF-e provider
NFE_PROVIDER=focus_nfe

# NF-e direta SEFAZ
SEFAZ_NFE_UF=SP
SEFAZ_NFE_SERIE=1
SEFAZ_NFE_CERTIFICATE_PATH=
SEFAZ_NFE_CERTIFICATE_PASSWORD=
SEFAZ_NFE_XSD_DIR=
SEFAZ_NFE_WS_URLS_JSON=
SEFAZ_NFE_VERIFY_TLS=true
COMPANY_IE=
COMPANY_IM=
COMPANY_CNAE=
COMPANY_CRT=1
COMPANY_STREET=
COMPANY_NUMBER=
COMPANY_DISTRICT=
COMPANY_CITY=
