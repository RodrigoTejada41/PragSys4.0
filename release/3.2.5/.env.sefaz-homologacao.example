# Perfil exemplo para emissao direta NF-e via SEFAZ em homologacao
# Copie os valores necessarios para o seu .env real quando for ativar a emissao direta.

NFE_PROVIDER=sefaz_direct

# Ambiente e UF
SEFAZ_NFE_UF=SP
SEFAZ_NFE_SERIE=1

# Certificado A1
SEFAZ_NFE_CERTIFICATE_PATH=C:\certificados\empresa_a1.pfx
SEFAZ_NFE_CERTIFICATE_PASSWORD=

# Schemas oficiais NF-e 4.00
SEFAZ_NFE_XSD_DIR=C:\sefaz\xsd\PL_009_V4

# URLs SOAP
# Se preferir sobrescrever por UF/ambiente, informe um JSON valido.
# Exemplo:
# SEFAZ_NFE_WS_URLS_JSON={"homologacao":{"SP":{"NFeAutorizacao":"https://...","NFeRetAutorizacao":"https://...","RecepcaoEvento":"https://..."}}}
SEFAZ_NFE_WS_URLS_JSON=
SEFAZ_NFE_VERIFY_TLS=false

# Emitente
COMPANY_CNPJ=
COMPANY_IE=
COMPANY_IM=
COMPANY_CNAE=
COMPANY_CRT=1
COMPANY_LEGAL_NAME=
COMPANY_TRADE_NAME=
COMPANY_STREET=
COMPANY_NUMBER=
COMPANY_DISTRICT=
COMPANY_CITY=
COMPANY_CITY_CODE=3550308
COMPANY_STATE=SP
COMPANY_STATE_CODE=35
COMPANY_ZIP_CODE=
COMPANY_PHONE=
